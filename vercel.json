{
    "version": 2,
    "builds": [
        {
            "src": "smartPharmacy/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.9",
                "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "smartPharmacy/staticfiles/$1"
        },
        {
            "src": "/(.*)",
            "dest": "smartPharmacy/wsgi.py"
        }
    ],
    "build": {
        "env": {
            "PYTHON_VERSION": "3.9",
            "DJANGO_SETTINGS_MODULE": "smartPharmacy.settings",
            "PG_CONFIG": "false"
        }
    }
}