{
    "version": 2,
    "builds": [
        {
            "src": "smartPharmacy/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "20mb",
                "runtime": "python3.9",
                "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput"
            }
        },
        {
            "src": "staticfiles/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/admin/(.*)",
            "dest": "/staticfiles/admin/$1"
        },
        {
            "src": "/static/(.*)",
            "dest": "/staticfiles/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/(.*)",
            "dest": "smartPharmacy/wsgi.py"
        }
    ]
}